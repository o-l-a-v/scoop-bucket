{
    "##": "Why here? Waiting for PR to be merged to the Scoop official Main bucket.",
    "version": "1.29-rc3+f1669",
    "description": "Image optimizer for web",
    "homepage": "https://css-ig.net/pingo",
    "license": {
        "identifier": "Unknown",
        "url": "https://css-ig.net/submit/licenses"
    },
    "url": "https://css-ig.net/bin/pingo.zip",
    "hash": "f166938cb1266d215a83ed7e4550e1edc2063b5e150b3d68712f7d25fa3b5f1c",
    "bin": "pingo.exe",
    "checkver": {
        "script": [
            "<#",
            "   Create version with first 5ch of SHA256 checksum,",
            "   because the author have multiple times updated the ZIP file,",
            "   without incrementing the version number.",
            "   Must also handle occasional unstable / preview releases, as",
            "   the download link always servers latest version, with no way",
            "   to download previous stable version.",
            "#>",
            "# Get stated version from webpage",
            "$Html = Invoke-RestMethod -Method 'Get' -Uri 'https://css-ig.net/pingo' -UseBasicParsing",
            "if ($Html -match 'v(?<ver>[\\d+.]+[^<]+)') {",
            "    $Version = $Matches['ver'].Replace(' ', '-')",
            "}",
            "else {",
            "    Throw 'Could not parse version from web page.'",
            "}",
            "# Get SHA256 checksum",
            "$WebClient = [System.Net.WebClient]::new()",
            "Try {",
            "    $Stream = $WebClient.OpenRead('https://css-ig.net/bin/pingo.zip')",
            "    $Sha256 = (Get-FileHash -InputStream $Stream -Algorithm 'SHA256').'Hash'.ToLower()",
            "}",
            "Finally {",
            "    if ($null -ne $Stream) {",
            "        $Stream.Dispose()",
            "    }",
            "    if ($null -ne $WebClient) {",
            "        $WebClient.Dispose()",
            "    }",
            "}",
            "if ([string]::IsNullOrWhiteSpace($Sha256)) {",
            "    Throw 'Failed to download file and calculate SHA256.'",
            "}",
            "# Output stated version with first 5 characters of the SHA256 checksum",
            "[string]::Format('{0}+{1}', $Version, $Sha256.Substring(0, 5))"
        ],
        "regex": "(.+)"
    },
    "autoupdate": {
        "url": "https://css-ig.net/bin/pingo.zip"
    }
}
