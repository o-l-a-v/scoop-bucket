{
    "##": "Why here? Waiting for PR to be merged to the Scoop official Extras bucket.",
    "version": "1.0.0.4+22051",
    "description": "Image optimizer for web",
    "homepage": "https://css-ig.net/pinga",
    "license": {
        "identifier": "Unknown",
        "url": "https://css-ig.net/submit/licenses"
    },
    "url": "https://css-ig.net/bin/pinga.zip",
    "hash": "22051ed12e2c30c69e3a0bdfccc7297f6385a7a27bb1be56b05d1b4cd475867d",
    "innosetup": true,
    "pre_install": [
        "# Rename the installer because it is named the same as the executable inside it",
        "Rename-Item -Path \"$dir\\pinga.exe\" -NewName \"pinga_setup.exe\"",
        "# Extract the installer and delete it afterwards",
        "Expand-InnoArchive -Path \"$dir\\pinga_setup.exe\" -DestinationPath \"$dir\" -Removal"
    ],
    "shortcuts": [
        [
            "pinga.exe",
            "pinga"
        ]
    ],
    "post_uninstall": [
        "# Inform of leftover files if any was found",
        "$LeftoverFiles = [string[]](",
        "    [System.IO.Path]::Combine($env:LOCALAPPDATA,'pinga.ini') | Where-Object -FilterScript {",
        "        [System.IO.File]::Exists($_)",
        "    }",
        ")",
        "if ($LeftoverFiles.Count -gt 0) {",
        "    $Message = [string] \"`r`nFound some leftover files you might want to delete:\"",
        "    $LeftoverFiles.ForEach{",
        "        $Message += \"`r`n* '{0}'\" -f $_",
        "    }",
        "    info $Message",
        "}"
    ],
    "checkver": {
        "script": [
            "# Get current version of manifest",
            "if ([string]::IsNullOrWhiteSpace($file)) {",
            "    Throw ('$file variable is null or whitespace, required to read from current manifest.')",
            "}",
            "if (-not [System.IO.File]::Exists($file)) {",
            "    Throw ('File \"{0}\" does not exist.' -f $file)",
            "}",
            "[PSCustomObject] $CurrentManifest = ConvertFrom-Json -InputObject (",
            "    Get-Content -Raw -Path $file -Encoding 'utf8'",
            ")",
            "[string] $CurrentVersion = $CurrentManifest.Version",
            "[string] $CurrentSha256 = $CurrentManifest.Hash",
            "if ([string]::IsNullOrWhiteSpace($CurrentVersion)) {",
            "    Throw 'Failed to read current version from current manifest.'",
            "}",
            "if ([string]::IsNullOrWhiteSpace($CurrentSha256)) {",
            "    Throw 'Failed to read current checksum from current manifest.'",
            "}",
            "# Get available checksum",
            "$WebClient = [System.Net.WebClient]::new()",
            "Try {",
            "    $Stream = $WebClient.OpenRead('https://css-ig.net/bin/pinga.zip')",
            "    [string] $AvailableSha256 = (Get-FileHash -InputStream $Stream -Algorithm 'SHA256').'Hash'.ToLower()",
            "    [string] $AvailableSha256Substring = $AvailableSha256.Substring(0, 5)",
            "}",
            "Finally {",
            "    if ($null -ne $Stream) {",
            "        $Stream.Dispose()",
            "    }",
            "    if ($null -ne $WebClient) {",
            "        $WebClient.Dispose()",
            "    }",
            "}",
            "if ([string]::IsNullOrWhiteSpace($AvailableSha256Substring)) {",
            "    Throw 'Failed to download file and calculate SHA256.'",
            "}",
            "# Return current version if no change in checksum",
            "if ($CurrentSha256 -eq $AvailableSha256) {",
            "    return $CurrentVersion",
            "}",
            "# Make current version ready for comparison",
            "[string] $CurrentVersionWithoutChecksum = $CurrentVersion.Split('+')[0]",
            "[System.Version] $CurrentSystemVersion = $CurrentVersionWithoutChecksum.Split('-')[0]",
            "$CurrentSystemVersion = [System.Version]::new(",
            "    $CurrentSystemVersion.Major,",
            "    $CurrentSystemVersion.Minor,",
            "    ($CurrentSystemVersion.Build, 0).Where{$_ -ge 0}[0],",
            "    ($CurrentSystemVersion.Revision, 0).Where{$_ -ge 0}[0]",
            ")",
            "[string] $CurrentVersionCompare = [string] $CurrentSystemVersion.ToString(3)",
            "if ($CurrentVersionWithoutChecksum.Contains('-')) {",
            "    $CurrentVersionCompare += '-' + $CurrentVersionWithoutChecksum.Split('-')[-1]",
            "}",
            "# Get stated version from webpage",
            "$Html = Invoke-RestMethod -Method 'Get' -Uri 'https://css-ig.net/pinga' -UseBasicParsing",
            "if ($Html -match 'v(?<ver>[\\d+.]+[^<]+)') {",
            "    [string] $AvailableVersion = $Matches['ver'].Replace(' ', '-')",
            "    [System.Version] $AvailableSystemVersion = $AvailableVersion.Split('-')[0]",
            "    $AvailableSystemVersion = [System.Version]::new(",
            "        $AvailableSystemVersion.Major,",
            "        $AvailableSystemVersion.Minor,",
            "        ($AvailableSystemVersion.Build, 0).Where{$_ -ge 0}[0]",
            "    )",
            "    [string] $AvailableVersionCompare = $AvailableSystemVersion.ToString(3)",
            "    if ($AvailableVersion.Contains('-')) {",
            "        $AvailableVersionCompare += '-' + $AvailableVersion.Split('-')[1]",
            "    }",
            "}",
            "else {",
            "    Throw 'Could not parse version from web page.'",
            "}",
            "# Modify version if this is a replacement of an already covered version",
            "if ($AvailableVersionCompare -eq $CurrentVersionCompare) {",
            "    $AvailableVersionCompare = [System.Version]::new(",
            "        $AvailableSystemVersion.Major,",
            "        $AvailableSystemVersion.Minor,",
            "        $AvailableSystemVersion.Build,",
            "        $CurrentSystemVersion.Revision + 1",
            "    ).ToString()",
            "}",
            "else {",
            "    $AvailableVersionCompare = [System.Version]::new(",
            "        $AvailableSystemVersion.Major,",
            "        $AvailableSystemVersion.Minor,",
            "        $AvailableSystemVersion.Build,",
            "        0",
            "    ).ToString()",
            "}",
            "if ($AvailableVersion.Contains('-')) {",
            "    $AvailableVersionCompare += '-' + $AvailableVersion.Split('-')[1]",
            "}",
            "# Return version",
            "return [string]::Format('{0}+{1}', $AvailableVersionCompare, $AvailableSha256Substring)"
        ],
        "regex": "(.+)"
    },
    "autoupdate": {
        "url": "https://css-ig.net/bin/pinga.zip"
    }
}
