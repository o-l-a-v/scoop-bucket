{
    "##": "Why here? Testing.",
    "version": "0.11.0",
    "description": "A fast all-in-one toolkit that augments Node.js instead of replacing it.",
    "homepage": "https://nubjs.com",
    "license": "MIT",
    "notes": "Run `nub pm shim` and add `$env:LOCALAPPDATA\\nub\\shims` to PATH for Corepack style shims",
    "architecture": {
        "64bit": {
            "url": "https://github.com/nubjs/nub/releases/download/v0.11.0/nub-win32-x64.zip",
            "hash": "14e428c144cb6728287cedee5cd5e5a2b0c359a2fbe2eb0bbc5db5c266d9cee1"
        },
        "arm64": {
            "url": "https://github.com/nubjs/nub/releases/download/v0.11.0/nub-win32-arm64.zip",
            "hash": "a859623fc5f359efa9a7dc19f225fac7f5f2fe253b6a8101054108d83c4cc742"
        }
    },
    "extract_dir": "bin",
    "post_install": [
        "# Update Corepack style shims if they've already been created",
        "if ([System.IO.Directory]::Exists([System.IO.Path]::Combine($env:LOCALAPPDATA, 'nub', 'shims'))) {",
        "    info 'Updating Corepack style shims (`nub pm shim`).'",
        "    $null = nub pm shim",
        "}"
    ],
    "bin": [
        "nub.exe",
        "nubx.exe"
    ],
    "post_uninstall": [
        "# Inform of leftover directories if any were found",
        "$LeftoverDirectories = [string[]](",
        "    [System.IO.Path]::Combine($env:LOCALAPPDATA, 'nub'),",
        "    [System.IO.Path]::Combine($env:USERPROFILE, '.config', 'nub')",
        "    [System.IO.Path]::Combine($env:USERPROFILE, '.cache', 'nub') | Where-Object -FilterScript {",
        "        [System.IO.Directory]::Exists($_)",
        "    }",
        ")",
        "if ($LeftoverDirectories.Count -gt 0) {",
        "    $Message = [string] \"`r`nFound some leftover directories you might want to delete:\"",
        "    $LeftoverDirectories.ForEach{",
        "        $Message += \"`r`n* '{0}'\" -f $_",
        "    }",
        "    info $Message",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/nubjs/nub"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nubjs/nub/releases/download/v$version/nub-win32-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/nubjs/nub/releases/download/v$version/nub-win32-arm64.zip"
            }
        }
    }
}
